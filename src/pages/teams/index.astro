---
import Base from "@/layouts/Base.astro";
import TitleBand from "@/components/TitleBand.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const teams = (await getSinglePage("teams")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Teams" description="Alle Teams der Bretten Kangaroos – von T-Ball bis Herren.">
  <TitleBand title="Teams" />
  <section class="py-12 md:py-16">
    <div class="container-wide">
      <p class="mb-10 max-w-2xl text-intro">
        Baseball und Softball für alle Altersstufen. Such dir dein Team aus
        oder komm einfach zum <a href="/probetraining" class="text-primary underline underline-offset-4">Probetraining</a>.
      </p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          teams.map((team) => {
            const slot = team.data.training[0];
            return (
              <li>
                <a href={`/teams/${team.id}`} class="flex h-full flex-col rounded-[6px] border border-line p-6 transition hover:border-forest hover:shadow-md">
                  <h2 class="!text-tile">{team.data.title}</h2>
                  {team.data.ages && <p class="label mt-1">{team.data.ages}</p>}
                  {team.data.league && <p class="mt-3">{team.data.league}</p>}
                  {slot && (
                    <p class="mt-3 text-ink">
                      Training: {slot.days}, {slot.time}
                    </p>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
