---
// Teams overview after the "Teams – Übersicht" board (docs/design/Teams.dc.html)
import Base from "@/layouts/Base.astro";
import TitleBand from "@/components/TitleBand.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const teams = (await getSinglePage("teams")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Teams" description="Alle Teams der Bretten Kangaroos – von T-Ball bis Herren.">
  <TitleBand
    title="Teams"
    intro="Baseball und Softball für alle Altersstufen. Neue Spielerinnen und Spieler sind in jedem Team jederzeit zum Probetraining willkommen."
  />

  <div class="container-wide pb-6 pt-8">
    <ul>
      {
        teams.map((team) => {
          const { title, ages, league, badge, training, coaches } = team.data;
          return (
            <li>
              <a
                href={`/teams/${team.id}`}
                class="group grid items-start gap-x-8 gap-y-3 border-b border-line py-7 sm:grid-cols-2 lg:grid-cols-[repeat(4,minmax(0,1fr))]"
              >
                <div class="flex flex-col gap-0.5">
                  <span class="font-heading text-[34px] font-bold uppercase leading-none text-ink">{title}</span>
                  {(ages || league) && <span>{[ages, league].filter(Boolean).join(" · ")}</span>}
                  {badge && (
                    <span class="mt-1.5 self-start rounded-full bg-forest px-2.5 py-0.5 text-[13px] font-semibold text-white">{badge}</span>
                  )}
                </div>
                {training.length > 0 && (
                  <div class="flex flex-col text-[15px] leading-normal">
                    <span class="label !text-[13px]">Training</span>
                    {training.map((slot, i) => (
                      <span class:list={[i > 0 ? "text-text" : "text-ink"]}>
                        {i > 0 && slot.season && `${slot.season}: `}
                        {slot.days}, {slot.time} · {slot.place}
                      </span>
                    ))}
                  </div>
                )}
                {coaches.length > 0 && (
                  <div class="flex flex-col text-[15px] leading-normal">
                    <span class="label !text-[13px]">{coaches.length > 1 ? "Coaches" : "Coach"}</span>
                    <span class="text-ink">{coaches.map((coach) => coach.name).join(", ")}</span>
                  </div>
                )}
                <span class="self-center font-semibold text-primary group-hover:underline lg:justify-self-end">
                  Zur Teamseite →
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <section class="container-wide flex flex-wrap gap-6 pb-20 pt-8">
    <div class="flex flex-[2_1_480px] flex-wrap items-center justify-between gap-5 rounded-[6px] bg-forest p-7 text-white">
      <div class="flex max-w-[440px] flex-col gap-1">
        <h2 class="text-[28px] leading-none !text-white">Probetraining</h2>
        <p class="text-[#DCE6D4]">Alle Trainingszeiten auf einen Blick, mit Ansprechpartner pro Team.</p>
      </div>
      <a href="/probetraining" class="btn btn-primary">Zeiten ansehen</a>
    </div>
    <a href="/bkil" class="flex flex-[1_1_280px] flex-col gap-1 rounded-[6px] border border-line p-7 transition hover:border-forest">
      <span class="label !text-[13px]">Außerdem</span>
      <strong class="text-[20px] text-ink">Intra League (BKIL)</strong>
      <span class="text-[15px]">Vereinsinterne Spiele mit gemischten Teams →</span>
    </a>
  </section>
</Base>
