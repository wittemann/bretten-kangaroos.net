---
import Base from "@/layouts/Base.astro";
import TeamSwitcher from "@/components/TeamSwitcher.astro";
import TitleBand from "@/components/TitleBand.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { render } from "astro:content";

export async function getStaticPaths() {
  const teams = await getSinglePage("teams");
  return teams.map((team) => ({ params: { slug: team.id }, props: { team } }));
}

const { team } = Astro.props;
const { title, ages, league, image, badge, training, coaches, email } =
  team.data;
const { Content } = await render(team);
const hasBody = Boolean(team.body?.trim());
const facts = [
  ages && { label: "Alter", value: ages },
  league && { label: "Liga", value: league },
].filter(Boolean) as { label: string; value: string }[];

// "Aus dem Team": the latest posts tagged with this team
const teamPosts = sortByDate(
  (await getSinglePage("news")).filter((post) => post.data.team === team.id),
).slice(0, 3);
const longDate = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base title={title} description={`${title} der Bretten Kangaroos`}>
  <TitleBand title={title} intro={[ages, league].filter(Boolean).join(" · ")}>
    <div class="mt-6"><TeamSwitcher current={team.id} /></div>
  </TitleBand>

  <section class="py-12 md:py-16">
    <div class="container-wide grid gap-10 lg:grid-cols-[1fr_340px]">
      <div>
        {image && <img src={image} alt={`Team ${title}`} class="mb-8 w-full rounded-[6px]" />}
        {hasBody && <div class="content"><Content /></div>}
        {
          !hasBody && !image && (
            <p class="text-intro">Mehr Infos zum Team folgen in Kürze.</p>
          )
        }
        {
          teamPosts.length > 0 && (
            <section class="mt-12" aria-labelledby="team-news">
              <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                <h2 id="team-news">Aus dem Team</h2>
                <a href={`/news/team/${team.id}`} class="font-semibold text-primary hover:underline">
                  Alle {title}-Beiträge →
                </a>
              </div>
              <ul class="divide-y divide-line border-y border-line">
                {teamPosts.map((post) => (
                  <li>
                    <a href={`/news/${post.id}`} class="group flex flex-col gap-1 py-4">
                      <span class="text-sm">{longDate.format(post.data.date)}</span>
                      <span class="font-semibold leading-snug text-ink group-hover:text-primary">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="space-y-8">
        {
          (facts.length > 0 || badge) && (
            <div class="rounded-[6px] border border-line p-6">
              {badge && <p class="label mb-3">{badge}</p>}
              <dl class="space-y-2">
                {facts.map((fact) => (
                  <div>
                    <dt class="label">{fact.label}</dt>
                    <dd class="text-ink">{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
        {
          training.length > 0 && (
            <div class="rounded-[6px] border border-line p-6">
              <h2 class="mb-4 !text-tile">Training</h2>
              <ul class="space-y-4">
                {training.map((slot) => (
                  <li>
                    {slot.season && <p class="label">{slot.season}</p>}
                    <p class="font-semibold text-ink">{slot.days}, {slot.time}</p>
                    <p>{slot.place}</p>
                  </li>
                ))}
              </ul>
              <a href="/probetraining" class="btn btn-primary mt-6 w-full">Probetraining</a>
            </div>
          )
        }
        {
          (coaches.length > 0 || email) && (
            <div class="rounded-[6px] border border-line p-6">
              <h2 class="mb-4 !text-tile">Trainer &amp; Kontakt</h2>
              <ul class="space-y-1">
                {coaches.map((coach) => (
                  <li class="text-ink">
                    {coach.name}
                    {coach.role && <span class="text-text-light"> · {coach.role}</span>}
                  </li>
                ))}
              </ul>
              {email && (
                <a href={`mailto:${email}`} class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4">
                  {email}
                </a>
              )}
            </div>
          )
        }
      </aside>
    </div>
  </section>
</Base>
