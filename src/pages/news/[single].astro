---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PostSingle from "@/partials/PostSingle.astro";

export async function getStaticPaths() {
  const posts = sortByDate(await getSinglePage("news"));

  // "Weitere Beiträge": the three newest other posts
  return posts.map((post) => ({
    params: { single: post.id },
    props: { post, morePosts: posts.filter((other) => other.id !== post.id).slice(0, 3) },
  }));
}

const { post, morePosts } = Astro.props;
const { title, image } = post.data;
---

<Base title={title} image={image}>
  <PostSingle post={post} morePosts={morePosts} />
</Base>
