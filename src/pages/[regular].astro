---
import Base from "@/layouts/Base.astro";
import TitleBand from "@/components/TitleBand.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getSinglePage("pages");

  const paths = pages.map((page) => ({
    params: {
      regular: page.id,
    },
    props: { page },
  }));
  return paths;
}

const { page } = Astro.props;
const { title, meta_title, description, image, files } = page.data;
const { Content } = await render(page);
// pages with "## 1992 – Title" headings get the year column
const hasYears = /^## \d{4} [–-] /m.test(page.body ?? "");
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <TitleBand title={title} />
  <section class="py-12 md:py-16">
    <div class="container-wide">
      <div class:list={["content max-w-3xl", hasYears && "content-years"]}>
        <Content />
      </div>
      {
        files.length > 0 && (
          <ul class="mt-8 max-w-3xl divide-y divide-line border-y border-line">
            {files.map((file) => (
              <li>
                <a
                  href={file.file}
                  download
                  class="flex min-h-14 items-center justify-between gap-4 py-3 font-heading text-intro font-semibold uppercase tracking-wide text-forest hover:text-primary"
                >
                  <span>{file.title}</span>
                  <span class="label">PDF</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
