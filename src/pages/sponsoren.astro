---
import Base from "@/layouts/Base.astro";
import Sponsors from "@/layouts/components/Sponsors.astro";
---

<Base
  title="Sponsoren"
  description="Die Sponsoren der Bretten Kangaroos – vielen Dank für eure Unterstützung!"
>
  <section class="section">
    <div class="container">
      <h1 class="h2 page-heading">Unsere Sponsoren</h1>
      <p class="mb-12 text-center">
        Ohne die Unterstützung unserer Sponsoren wäre Baseball und Softball in
        Bretten nicht möglich. Vielen Dank!
      </p>
      <Sponsors size="large" />
    </div>
  </section>
</Base>
