---
// Tournament sign-up form. The form posts to /signup.php
// (public/signup.php), which sends a mail via SMTP and redirects back here
// (?signup=<status>#signup). Visitor-facing texts are German.
const messages: Record<string, { type: string; text: string }> = {
  ok: {
    type: "tip",
    text: "Danke für eure Anmeldung! Wir haben sie erhalten und melden uns bei euch.",
  },
  invalid: {
    type: "warning",
    text: "Bitte prüft eure Angaben – Teamname, Ansprechpartner, eine gültige E-Mail-Adresse und die Anzahl der Spieler sind Pflicht.",
  },
  "too-fast": {
    type: "warning",
    text: "Das ging etwas zu schnell. Bitte schickt das Formular in ein paar Sekunden noch einmal ab.",
  },
  expired: {
    type: "warning",
    text: "Das Formular war zu lange offen oder unvollständig geladen. Bitte schickt es noch einmal ab.",
  },
  limit: {
    type: "warning",
    text: "Es kamen zu viele Anmeldungen von eurem Anschluss. Bitte versucht es später noch einmal oder schreibt uns direkt eine E-Mail.",
  },
  error: {
    type: "warning",
    text: "Die Anmeldung konnte gerade nicht verschickt werden. Bitte versucht es später noch einmal oder schreibt uns direkt eine E-Mail.",
  },
};
---

<section id="signup" class="section">
  <div class="container">
    <div class="mx-auto max-w-[700px]">
      <h2 class="h3 mb-4">Anmeldung zum Turnier</h2>
      <p class="mb-8">
        Meldet euer Team hier an. Die Angaben gehen per E-Mail an uns und werden
        nur für die Organisation des Turniers verwendet.
      </p>

      <div id="signup-status" aria-live="polite">
        {
          Object.entries(messages).map(([status, { type, text }]) => (
            <div class={`notice ${type}`} data-status={status} hidden>
              <p class="my-0">{text}</p>
            </div>
          ))
        }
      </div>

      <form
        id="signup-form"
        class="form-inputs"
        action="/signup.php"
        method="post"
        data-astro-reload
      >
        <input type="hidden" name="token" value="" />

        <label for="signup-team" class="block">Teamname *</label>
        <input id="signup-team" name="team" type="text" class="form-input w-full" required maxlength="100" autocomplete="organization" />

        <label for="signup-name" class="block">Ansprechpartner *</label>
        <input id="signup-name" name="name" type="text" class="form-input w-full" required maxlength="100" autocomplete="name" />

        <label for="signup-email" class="block">E-Mail *</label>
        <input id="signup-email" name="email" type="email" class="form-input w-full" required maxlength="254" autocomplete="email" />

        <label for="signup-phone" class="block">Telefon</label>
        <input id="signup-phone" name="phone" type="tel" class="form-input w-full" maxlength="40" pattern="[0-9+()\/ .\-]{3,40}" autocomplete="tel" />

        <label for="signup-players" class="block">Anzahl Spieler *</label>
        <input id="signup-players" name="players" type="number" class="form-input w-full" required min="1" max="99" step="1" />

        <label for="signup-comment" class="block">Kommentar</label>
        <textarea id="signup-comment" name="comment" class="form-textarea w-full" rows="5" maxlength="2000"></textarea>

        <!-- Honeypot: invisible to humans, bots fill it in. -->
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="signup-website">Website (bitte leer lassen)</label>
          <input id="signup-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-primary">Team anmelden</button>
      </form>
    </div>
  </div>
</section>

<script>
  // Show the status from the redirect and fetch the form token. Inputs are
  // only kept in the browser's sessionStorage so they don't have to be typed
  // again after an error message.
  // Runs on every page load, also after navigation via the ClientRouter.
  const STORAGE_KEY = "tournament-signup";
  const fields = ["team", "name", "email", "phone", "players", "comment"];

  function init() {
    const form = document.getElementById("signup-form") as HTMLFormElement | null;
    if (!form) return;

    const params = new URLSearchParams(location.search);
    const status = params.get("signup");
    if (status) {
      const box = document.querySelector<HTMLElement>(
        `#signup-status [data-status="${CSS.escape(status)}"]`,
      );
      if (box) box.hidden = false;
      // Remove the status from the address bar so it doesn't reappear on reload.
      history.replaceState(history.state, "", location.pathname + location.hash);
    }

    try {
      if (status === "ok") {
        sessionStorage.removeItem(STORAGE_KEY);
      } else if (status) {
        const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || "{}");
        for (const f of fields) {
          const el = form.elements.namedItem(f) as HTMLInputElement | null;
          if (el && typeof saved[f] === "string") el.value = saved[f];
        }
      }
    } catch {
      // sessionStorage not available – then just don't restore.
    }

    const tokenInput = form.elements.namedItem("token") as HTMLInputElement;
    const loadToken = async () => {
      const res = await fetch("/signup.php?token", { cache: "no-store" });
      tokenInput.value = (await res.json()).token;
    };
    const tokenReady = loadToken().catch(() => {});

    form.addEventListener("submit", async (event) => {
      try {
        const data: Record<string, string> = {};
        for (const f of fields) {
          data[f] = (form.elements.namedItem(f) as HTMLInputElement).value;
        }
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch {
        // ignore
      }
      if (!tokenInput.value) {
        event.preventDefault();
        await tokenReady;
        if (!tokenInput.value) await loadToken().catch(() => {});
        form.submit();
      }
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
