---
// Small standings table for a team page sidebar (Pl., Team, S, N), own row
// highlighted. Uses the first league of the team that has a table.
import { rowLogos, standingsFor } from "@/lib/bsm";

const { team, title = "Tabelle" } = Astro.props;
const league = standingsFor(team).find((l) => l.standings?.length);
---

{
  league && (
    <section aria-label={title}>
      <h2 class="mb-3 text-[26px]">{title}</h2>
      <div class="overflow-x-auto rounded-[6px] border border-line">
        <table class="w-full border-collapse text-[15px]">
          <thead>
            <tr class="bg-chalk text-left text-ink">
              <th class="px-3 py-2 font-semibold">Pl.</th>
              <th class="px-3 py-2 font-semibold">Team</th>
              <th class="px-2 py-2 text-right font-semibold">S</th>
              <th class="px-3 py-2 text-right font-semibold">N</th>
            </tr>
          </thead>
          <tbody>
            {league.standings!.map((row) => (
              <tr class:list={["border-t border-line", row.isUs ? "bg-[#EEF4E8] font-semibold text-ink" : "text-text"]}>
                <td class="px-3 py-2">{row.rank ? `${row.rank}.` : ""}</td>
                <td class="px-3 py-2">
                  <span class="flex items-center gap-2">
                    {rowLogos(row).slice(0, 1).map((src) => (
                      <img src={src} alt="" width="20" height="20" loading="lazy" class="size-5 shrink-0 object-contain" />
                    ))}
                    <span class="leading-snug">{row.team}</span>
                  </span>
                </td>
                <td class="px-2 py-2 text-right tabular-nums">{row.wins}</td>
                <td class="px-3 py-2 text-right tabular-nums">{row.losses}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
