---
// League tables from the BSM, one per league with standings. `team` limits
// them to one team (for team pages).
import { formatDateTime, standingsFor } from "@/lib/bsm";

type Props = { team?: string };

const { team } = Astro.props;
const tables = standingsFor(team);
---

<div class="space-y-16">
  {
    tables.map((league) => (
      <section>
        <h2 class="h4 mb-6">{league.label}</h2>
        {league.standings?.length ? (
          <div class="border-border overflow-x-auto rounded-lg border">
            <table class="w-full text-left text-sm">
              <thead class="bg-light text-text-dark">
                <tr>
                  <th class="px-2 py-3 text-right font-semibold sm:px-3">
                    Platz
                  </th>
                  <th class="px-2 py-3 font-semibold sm:px-3">Team</th>
                  <th
                    class="hidden px-2 py-3 text-right font-semibold sm:table-cell sm:px-3"
                    title="Spiele"
                  >
                    Sp.
                  </th>
                  <th
                    class="px-2 py-3 text-right font-semibold sm:px-3"
                    title="Siege"
                  >
                    S
                  </th>
                  <th
                    class="px-2 py-3 text-right font-semibold sm:px-3"
                    title="Niederlagen"
                  >
                    N
                  </th>
                  <th
                    class="px-2 py-3 text-right font-semibold sm:px-3"
                    title="Siegquote"
                  >
                    Quote
                  </th>
                  <th
                    class="hidden px-2 py-3 text-right font-semibold sm:table-cell sm:px-3"
                    title="Spiele Rückstand"
                  >
                    GB
                  </th>
                  <th
                    class="hidden px-2 py-3 text-right font-semibold sm:table-cell sm:px-3"
                    title="Serie"
                  >
                    Serie
                  </th>
                </tr>
              </thead>
              <tbody>
                {league.standings.map((row) => (
                  <tr
                    class:list={[
                      "border-border border-t",
                      row.isUs && "bg-primary/10 text-text-dark font-semibold",
                    ]}
                  >
                    <td class="px-2 py-3 text-right tabular-nums sm:px-3">
                      {row.rank ? `${row.rank}.` : ""}
                    </td>
                    <td class="px-2 py-3 sm:px-3">{row.team}</td>
                    <td class="hidden px-2 py-3 text-right tabular-nums sm:table-cell sm:px-3">
                      {row.games}
                    </td>
                    <td class="px-2 py-3 text-right tabular-nums sm:px-3">
                      {row.wins}
                    </td>
                    <td class="px-2 py-3 text-right tabular-nums sm:px-3">
                      {row.losses}
                    </td>
                    <td class="px-2 py-3 text-right tabular-nums sm:px-3">
                      {row.pct}
                    </td>
                    <td class="hidden px-2 py-3 text-right tabular-nums sm:table-cell sm:px-3">
                      {row.gamesBehind}
                    </td>
                    <td class="hidden px-2 py-3 text-right tabular-nums sm:table-cell sm:px-3">
                      {row.streak}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p>Die Tabelle ist zurzeit nicht verfügbar.</p>
        )}
        {league.fetchedAt && (
          <p class="text-text-light mt-3 text-sm">
            Stand: {formatDateTime(league.fetchedAt)} · Quelle: BSM
          </p>
        )}
      </section>
    ))
  }
</div>
