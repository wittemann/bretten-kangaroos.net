---
// Numbered page links after the Aktuelles board: first, last and the pages
// around the current one, "← Neuere" / "Ältere →" at the ends.
const { section, currentPage, totalPages } = Astro.props;

const pageHref = (page: number) =>
  page === 1 ? `${section ? "/" + section : "/"}` : `${section ? "/" + section : ""}/page/${page}`;

// "gap" marks skipped pages. Neighbours of the current page are hidden on
// phones to keep the row narrow.
const shown = [...new Set([1, currentPage - 1, currentPage, currentPage + 1, totalPages])]
  .filter((page) => page >= 1 && page <= totalPages)
  .sort((a, b) => a - b);
let pageList: (number | "gap")[] = [];
shown.forEach((page, i) => {
  if (i > 0 && page - shown[i - 1] > 1) pageList.push("gap");
  pageList.push(page);
});
const isNeighbour = (page: number) =>
  Math.abs(page - currentPage) === 1 && page !== 1 && page !== totalPages;

const box = "inline-flex h-11 min-w-11 items-center justify-center rounded-[4px] font-semibold";
const link = `${box} border border-[#C9C9C2] text-ink transition hover:border-forest`;
---

{
  totalPages > 1 && (
    <nav class="flex flex-wrap justify-center gap-2" aria-label="Seiten">
      {currentPage > 1 && (
        <a href={pageHref(currentPage - 1)} class={`${link} px-4`}>← Neuere</a>
      )}
      {pageList.map((page) =>
        page === "gap" ? (
          <span class={`${box} text-text`} aria-hidden="true">…</span>
        ) : page === currentPage ? (
          <span aria-current="page" class={`${box} bg-forest text-white`}>{page}</span>
        ) : (
          <a href={pageHref(page)} class:list={[link, isNeighbour(page) && "max-sm:hidden"]}>{page}</a>
        ),
      )}
      {currentPage < totalPages && (
        <a href={pageHref(currentPage + 1)} class={`${link} px-4`}>Ältere →</a>
      )}
    </nav>
  )
}
