---
// Spielplan after the boards (docs/design/Spielplan-Saison.dc.html and
// Spielplan-Clubhaus.dc.html): upcoming games grouped by day with "In meinen
// Kalender", the subscription box, then results grouped by month. Rows carry
// data-team for the filter pills in the title band (BsmTeamFilter).
import { formatTime, splitGames, teams, type GameWithLeague } from "@/lib/bsm";
import { googleEventUrl, isCanceled } from "@/lib/calendar";
import CalendarSubscribe from "@/components/CalendarSubscribe.astro";

const { upcoming, results } = splitGames();

const TIME_ZONE = "Europe/Berlin";
const dayKey = (iso: string) => new Intl.DateTimeFormat("en-CA", { timeZone: TIME_ZONE }).format(new Date(iso));
const dayTitle = new Intl.DateTimeFormat("de-DE", { timeZone: TIME_ZONE, weekday: "long", day: "numeric", month: "long" });
const monthTitle = new Intl.DateTimeFormat("de-DE", { timeZone: TIME_ZONE, month: "long", year: "numeric" });
const shortDate = new Intl.DateTimeFormat("de-DE", { timeZone: TIME_ZONE, weekday: "short", day: "2-digit", month: "2-digit" });

const groupBy = <T,>(items: T[], key: (item: T) => string) => {
  const groups = new Map<string, T[]>();
  items.forEach((item) => groups.set(key(item), [...(groups.get(key(item)) ?? []), item]));
  return [...groups.values()];
};

// "Spiel 1 von 2" for doubleheaders: same day, same team, same opponent
const opponent = (game: GameWithLeague) => (game.isHome ? game.away.name : game.home.name);
const doubleheader = new Map<number, string>();
groupBy(upcoming, (g) => `${dayKey(g.start)}|${g.league.team}|${opponent(g)}`).forEach((games) => {
  if (games.length > 1) games.forEach((g, i) => doubleheader.set(g.id, `Spiel ${i + 1} von ${games.length}`));
});

const days = groupBy(upcoming, (g) => dayKey(g.start));
const months = groupBy(results, (g) => dayKey(g.start).slice(0, 7));

const leagueLine = (game: GameWithLeague) => game.league.label.replace(" – ", " · ");
const mapsUrl = (game: GameWithLeague) =>
  game.field &&
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    [game.field.name, game.field.street, game.field.city].filter(Boolean).join(", "),
  )}`;

const outcome = {
  W: { text: "Sieg", class: "bg-[#E3EFDC] text-[#1A5E2E]" },
  L: { text: "Niederlage", class: "bg-[#F5E4D6] text-[#7A3309]" },
  T: { text: "Unentschieden", class: "bg-chalk text-ink" },
};
// Results that are not a normal played game get their BSM label
const resultNote = (game: GameWithLeague) => {
  if (game.state === "played") return null;
  if (game.state === "planned") return "kein Ergebnis gemeldet";
  return game.stateLabel;
};

// After the season (Sep–Dec) the next schedule is the next year's
const now = new Date();
const nextSeason = now.getMonth() >= 8 ? now.getFullYear() + 1 : null;
---

<div data-bsm-games class="flex flex-col gap-12">
  <section data-section aria-labelledby="upcoming-games">
    <h2 id="upcoming-games" class="mb-4">Nächste Spiele</h2>
    <div class="flex flex-col gap-4">
      {
        days.map((games) => {
          const homeDay = games.every((g) => g.isHome && !isCanceled(g));
          return (
            <div class="rounded-[6px] border border-line" data-group>
              <div
                class:list={[
                  "flex flex-wrap items-baseline justify-between gap-x-3 rounded-t-[6px] px-4 py-2.5 md:px-5",
                  homeDay ? "bg-forest text-white" : "bg-chalk text-ink",
                ]}
              >
                <h3 class:list={["text-[20px] tracking-wide", homeDay && "!text-white"]}>{dayTitle.format(new Date(games[0].start))}</h3>
                {homeDay && <span class="text-sm text-[#C7D8B8]">Heimspieltag am Ballpark</span>}
              </div>
              <ul>
                {games.map((game) => {
                  const canceled = isCanceled(game);
                  const meta = [
                    leagueLine(game),
                    doubleheader.get(game.id),
                    game.isHome ? "Heimspiel" : `Auswärts${game.field?.city ? ` in ${game.field.city}` : ""}`,
                  ].filter(Boolean);
                  return (
                    <li
                      class:list={["flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line px-4 py-4 md:px-5", canceled && "text-[#6B6B66]"]}
                      data-team={game.league.team}
                    >
                      <span class:list={["w-[70px] font-heading text-[26px] font-bold leading-none", canceled && "line-through"]}>
                        {formatTime(game.start)}
                      </span>
                      <div class="min-w-0 flex-[1_1_300px] leading-snug">
                        <div class:list={["text-[18px]", canceled ? "line-through" : "text-ink"]}>
                          <span class:list={[game.home.isUs && "font-semibold"]}>{game.home.name}</span>
                          {" – "}
                          <span class:list={[game.away.isUs && "font-semibold"]}>{game.away.name}</span>
                        </div>
                        <div class="text-sm">
                          {meta.join(" · ")}
                          {!game.isHome && mapsUrl(game) && !canceled && (
                            <>
                              {" · "}
                              <a href={mapsUrl(game)} target="_blank" rel="noopener" class="text-primary underline underline-offset-2">Anfahrt</a>
                            </>
                          )}
                        </div>
                      </div>
                      {canceled ? (
                        <span class="inline-flex min-h-8 items-center rounded-[4px] bg-[#F5E4D6] px-3 text-sm font-semibold text-[#7A3309]">abgesagt</span>
                      ) : (
                        <details class="calendar-menu relative">
                          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-[4px] border border-[#C9C9C2] bg-white px-3.5 text-[15px] font-semibold text-ink">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" /></svg>
                            In meinen Kalender
                            <span class="sr-only">: {game.home.name} – {game.away.name}, {formatTime(game.start)} Uhr</span>
                          </summary>
                          <div class="absolute left-0 z-10 mt-2 flex w-[290px] sm:left-auto sm:right-0 flex-col rounded-[6px] border border-line bg-white p-2 shadow-[0_14px_32px_rgba(20,30,18,0.18)]">
                            <a href={`/kalender/spiel/${game.id}.ics`} download class="flex flex-col rounded-[4px] px-3 py-2.5 leading-snug hover:bg-[#F0F5EC]">
                              <strong class="text-[15px] text-ink">Apple, Outlook &amp; andere</strong>
                              <span class="text-[13px]">lädt eine .ics-Datei</span>
                            </a>
                            <a href={googleEventUrl(game)} target="_blank" rel="noopener" class="flex flex-col rounded-[4px] px-3 py-2.5 leading-snug hover:bg-[#F0F5EC]">
                              <strong class="text-[15px] text-ink">Google Kalender</strong>
                              <span class="text-[13px]">öffnet Google mit dem Termin</span>
                            </a>
                          </div>
                        </details>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })
      }
      <p class="rounded-[6px] border border-dashed border-[#C9C9C2] p-5" data-empty hidden={upcoming.length > 0}>
        {
          nextSeason
            ? `Die Saison ist vorbei. Die Termine für ${nextSeason} erscheinen hier, sobald der Verband sie veröffentlicht.`
            : "Zurzeit sind keine Spiele angesetzt. Neue Termine erscheinen hier, sobald der Verband sie veröffentlicht."
        }
      </p>
    </div>
  </section>

  <CalendarSubscribe teams={teams} />

  <section data-section data-results aria-labelledby="results">
    <h2 id="results" class="mb-4">Ergebnisse</h2>
    <div class="flex flex-col gap-4">
      {
        months.map((games) => (
          <div class="overflow-hidden rounded-[6px] border border-line" data-group>
            <h3 class="bg-chalk px-4 py-2.5 font-heading text-[15px] font-semibold uppercase tracking-[0.12em] !text-text md:px-5">
              {monthTitle.format(new Date(games[0].start))}
            </h3>
            <ul>
              {games.map((game) => {
                const note = resultNote(game);
                const result = game.result && outcome[game.result];
                const hasScore = game.homeRuns != null && game.awayRuns != null;
                return (
                  <li class="grid grid-cols-[80px_minmax(0,1fr)] items-center gap-x-4 gap-y-1.5 border-t border-line px-4 py-3.5 sm:grid-cols-[80px_minmax(0,1fr)_auto] md:px-5" data-team={game.league.team} data-result>
                    <span class="text-sm leading-snug">
                      <strong class="text-ink">{shortDate.format(new Date(game.start)).replace(",", "")}</strong>
                      <br />
                      {formatTime(game.start)}
                    </span>
                    <div class="min-w-0 leading-snug text-ink">
                      <span class:list={[game.home.isUs && "font-semibold"]}>{game.home.name}</span>
                      {" – "}
                      <span class:list={[game.away.isUs && "font-semibold"]}>{game.away.name}</span>
                      <div class="text-[13px] text-text">
                        {leagueLine(game)}
                        {" · "}
                        {game.isHome ? "Heimspiel" : `Auswärts${game.field?.city ? ` in ${game.field.city}` : ""}`}
                        {note && ` · ${note}`}
                      </div>
                    </div>
                    <div class="col-start-2 flex items-center gap-3 sm:col-start-auto">
                      <span class:list={["min-w-[52px] text-right font-heading text-[26px] font-bold tabular-nums", hasScore ? "text-ink" : "text-[#9A9A94]"]}>
                        {hasScore ? `${game.homeRuns}:${game.awayRuns}` : "–"}
                      </span>
                      <span class:list={["min-w-[92px] rounded-[4px] py-0.5 text-center text-[13px] font-semibold", result?.class]}>
                        {result?.text}
                      </span>
                      {game.scoresheetUrl ? (
                        <a href={game.scoresheetUrl} target="_blank" rel="noopener noreferrer" class="text-[13px] text-primary underline underline-offset-2">
                          Spielbericht
                        </a>
                      ) : (
                        <span class="w-[72px]" />
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
      <p class="rounded-[6px] border border-dashed border-[#C9C9C2] p-5" data-empty hidden={results.length > 0}>Noch keine Ergebnisse.</p>
    </div>
    <button type="button" class="mt-4 inline-flex min-h-11 cursor-pointer items-center font-semibold text-primary hover:underline" data-show-all hidden>
      Alle Ergebnisse der Saison →
    </button>
  </section>
</div>

<script>
  // "In meinen Kalender": only one menu open; a click elsewhere or Escape closes it
  function init() {
    const menus = [...document.querySelectorAll<HTMLDetailsElement>("details.calendar-menu")];
    menus.forEach((menu) =>
      menu.addEventListener("toggle", () => {
        if (menu.open) menus.forEach((other) => other !== menu && (other.open = false));
      }),
    );
    const closeAll = () => menus.forEach((menu) => (menu.open = false));
    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest("details.calendar-menu")) closeAll();
    });
    document.addEventListener("keydown", (event) => event.key === "Escape" && closeAll());
  }

  document.addEventListener("astro:page-load", init);
</script>
