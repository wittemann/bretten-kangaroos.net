---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getCollection } from "astro:content";
import { teamNames, teamSlugs } from "@/lib/teams";

const { main, cta, address } = menu;
const verein = main.find((item) => item.hasChildren)!;
const mainLinks = main.filter((item) => !item.hasChildren);
const topLinks = mainLinks.filter((item) => item.url !== "/teams");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (url: string) => pathname === url || pathname.startsWith(`${url}/`);
// Ages under the team tiles of the phone menu, from the team files
const teamAges = Object.fromEntries((await getCollection("teams")).map((team) => [team.id, team.data.ages]));
const socialLinks = [
  { name: "Instagram", url: social.main.instagram },
  { name: "Facebook", url: social.main.facebook },
].filter((link) => link.url);
---

<header class="site-header sticky top-0 z-40 bg-forest text-white">
  <nav class="container-wide flex h-[72px] items-center justify-between gap-6" aria-label="Hauptmenü">
    <a href="/" class="flex items-center gap-3" aria-label={`${config.site.title} – Startseite`}>
      <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white">
        <img src="/images/crest.png" alt="" width="48" height="48" class="h-10 w-10 object-contain" />
      </span>
      <span class="font-heading text-[22px] font-bold uppercase leading-none tracking-wide">
        Bretten<br />Kangaroos
      </span>
    </a>

    <!-- desktop -->
    <ul class="hidden items-center gap-1 lg:flex">
      {mainLinks.map((item) => (
        <li>
          <a href={item.url} class="header-link" aria-current={isActive(item.url) ? "page" : undefined}>
            {item.name}
          </a>
        </li>
      ))}
      <li class="relative" data-dropdown>
        <button type="button" class="header-link" aria-expanded="false" aria-controls="verein-menu" data-dropdown-toggle>
          {verein.name}
          <svg class="ml-1 h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5.3 7.3 10 12l4.7-4.7 1.4 1.4L10 14.8 3.9 8.7z" />
          </svg>
        </button>
        <div id="verein-menu" class="verein-menu" hidden>
          <ul class="grid flex-1 grid-cols-2 content-start gap-0.5 p-3.5">
            {verein.children?.map((child) => (
              <li>
                <a href={child.url} class="verein-item" aria-current={isActive(child.url) ? "page" : undefined}>
                  <strong class="text-[17px] font-semibold text-ink">{child.name}</strong>
                  <span class="text-sm text-text-light">{child.description}</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="flex w-[180px] shrink-0 flex-col gap-2.5 bg-chalk px-[18px] py-[22px] text-sm leading-normal">
            <img src="/images/crest.png" alt="" width="72" height="72" class="h-[72px] w-[72px] object-contain" />
            <address class="flex flex-col gap-2.5 not-italic">
              <strong class="text-[15px] text-ink">{address.name}</strong>
              <span class="text-text-light">{address.street}<br />{address.city}</span>
            </address>
            <a href={address.url} class="font-semibold text-primary hover:underline">{address.label} →</a>
          </div>
        </div>
      </li>
      <li class="ml-3">
        <a href={cta.url} class="btn btn-primary">{cta.name}</a>
      </li>
    </ul>

    <!-- phone menu button -->
    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-[4px] lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
      data-menu-open
    >
      <svg class="h-7 w-7 fill-current" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0v-2z" />
      </svg>
    </button>
  </nav>

  <!-- phone: full-screen menu -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="flex items-center justify-between gap-3 border-b border-white/15 px-4 py-2.5">
      <a href="/" class="flex items-center gap-2.5" aria-label={`${config.site.title} – Startseite`}>
        <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white">
          <img src="/images/crest.png" alt="" width="44" height="44" class="h-10 w-10 object-contain" />
        </span>
        <span class="font-heading text-[20px] font-bold uppercase tracking-wide">Bretten Kangaroos</span>
      </a>
      <button type="button" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[4px] border border-white/35" aria-label="Menü schließen" data-menu-close>
        <svg class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <div class="flex flex-col gap-[22px] px-4 pb-8 pt-5">
      <a href={cta.url} class="btn btn-primary min-h-[52px] w-full text-[20px]">{cta.name}</a>
      <ul>
        {topLinks.map((item) => (
          <li class="border-b border-white/15">
            <a href={item.url} class="mobile-link" aria-current={isActive(item.url) ? "page" : undefined}>{item.name}</a>
          </li>
        ))}
      </ul>
      <div>
        <a href="/teams" class="label mb-2 inline-flex min-h-8 items-center !text-leaf">Teams</a>
        <ul class="grid grid-cols-2 gap-2">
          {teamSlugs.map((slug) => (
            <li>
              <a href={`/teams/${slug}`} class="flex min-h-14 flex-col justify-center rounded-[4px] bg-white/[0.08] px-3 py-2 leading-tight">
                <strong class="text-[17px] font-semibold">{teamNames[slug]}</strong>
                {teamAges[slug] && <span class="text-[13px] text-[#C7D8B8]">{teamAges[slug]}</span>}
              </a>
            </li>
          ))}
          <li>
            <a href="/teams" class="flex min-h-14 items-center rounded-[4px] border border-white/30 px-3 text-[17px] font-semibold">Alle Teams</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="label mb-1 !text-leaf">{verein.name}</p>
        <ul>
          {verein.children?.map((child) => (
            <li class="border-b border-white/10 last:border-b-0">
              <a href={child.url} class="flex min-h-11 items-center text-[18px] text-white">{child.name}</a>
            </li>
          ))}
        </ul>
      </div>
      {socialLinks.length > 0 && (
        <ul class="flex gap-5 text-[15px]">
          {socialLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-[#C7D8B8] underline underline-offset-4 hover:text-white">{link.name}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</header>

<script>
  const setup = () => {
    // Verein dropdown (hover for mouse, click/keys for touch and keyboard)
    document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((root) => {
      const toggle = root.querySelector<HTMLButtonElement>("[data-dropdown-toggle]")!;
      const panel = root.querySelector<HTMLElement>("#verein-menu")!;
      let timer: number | undefined;
      // set when hover opened the panel, so the click that usually follows keeps it open
      let openedByHover = false;
      const set = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        panel.hidden = !open;
      };
      toggle.addEventListener("click", () => {
        if (openedByHover) {
          openedByHover = false;
          return;
        }
        set(!!panel.hidden);
      });
      root.addEventListener("mouseenter", () => {
        clearTimeout(timer);
        if (panel.hidden) openedByHover = true;
        set(true);
      });
      root.addEventListener("mouseleave", () => {
        openedByHover = false;
        timer = window.setTimeout(() => set(false), 120);
      });
      root.addEventListener("focusout", (event) => {
        if (!root.contains(event.relatedTarget as Node)) set(false);
      });
      root.addEventListener("keydown", (event) => {
        if ((event as KeyboardEvent).key === "Escape") {
          set(false);
          toggle.focus();
        }
      });
    });

    // phone menu
    const menu = document.getElementById("mobile-menu")!;
    const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]")!;
    const closer = document.querySelector<HTMLButtonElement>("[data-menu-close]")!;
    const setMenu = (open: boolean) => {
      menu.hidden = !open;
      opener.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("overflow-hidden", open);
      (open ? closer : opener).focus();
    };
    opener.addEventListener("click", () => setMenu(true));
    closer.addEventListener("click", () => setMenu(false));
    menu.addEventListener("keydown", (event) => {
      if ((event as KeyboardEvent).key === "Escape") setMenu(false);
    });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches && !menu.hidden) setMenu(false);
    });
  };
  document.addEventListener("astro:page-load", setup);
</script>
